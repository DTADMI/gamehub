# Core app
NEXT_PUBLIC_API_URL="http://localhost:3000"
NEXT_PUBLIC_APP_VERSION="dev"
NEXT_PUBLIC_DISABLE_PROVIDERS="false"
NEXT_PUBLIC_FEATURE_REALTIME="true"
NEXT_PUBLIC_ENABLE_UPCOMING_PLAY_LOCAL="false"
NEXT_PUBLIC_E2E="false"
NEXT_PUBLIC_DEFAULT_LOCALE="en"
NEXT_PUBLIC_SUPPORTED_LOCALES="en,fr"
NEXT_PUBLIC_CONTACT_EMAIL="contact@gamehub.app"
E2E_ADMIN_BYPASS_TOKEN=""

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret"

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_PUBLISHABLE_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"
SUPABASE_JWT_SECRET="YOUR_SUPABASE_JWT_SECRET"

# Upstash Redis
KV_REST_API_URL="https://YOUR_UPSTASH_INSTANCE.upstash.io"
KV_REST_API_TOKEN="YOUR_UPSTASH_TOKEN"

# Optional social links
NEXT_PUBLIC_GITHUB_URL="https://github.com/your-handle"
NEXT_PUBLIC_LINKEDIN_URL="https://www.linkedin.com/in/your-handle"

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_XXXXXXXXXXXXXXXXXXXX
STRIPE_PUBLISHABLE_KEY=pk_test_XXXXXXXXXXXXXXXXXXXX
STRIPE_SECRET_KEY=sk_test_XXXXXXXXXXXXXXXXXXXX
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXXXXXX
STRIPE_PRICE_PREMIUM_MONTHLY=price_xxx
STRIPE_PRICE_PREMIUM_YEARLY=price_xxx

# OAuth (optional)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Shared (AdSense — cross-project consistency)
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=ca-pub-XXXXXXXXXXXXXXXX

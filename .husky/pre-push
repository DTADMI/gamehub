#!/usr/bin/env sh

set -e

echo "[pre-push] Running lint..."
pnpm lint > .husky-push-lint.log 2>&1

echo "[pre-push] Running type-check..."
pnpm type-check

echo "[pre-push] Running unit tests (non-blocking)..."
pnpm test:unit > .husky-push-test.log 2>&1 || echo "[pre-push] Warning: some unit tests failed"

echo "[pre-push] Building..."
pnpm build > .husky-push-build.log 2>&1

echo "[pre-push] All critical checks passed."
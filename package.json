{
  "name": "gamehub",
  "version": "0.1.0",
  "private": true,
  "description": "GameHub - Next.js portfolio + game platform",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.5.0"
  },
  "packageManager": "pnpm@11.5.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --exclude='tests/integration/**'",
    "test:integration": "vitest run tests/integration",
    "test:all": "pnpm type-check && vitest run && pnpm test:e2e:smoke",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test tests-e2e/smoke.spec.ts tests-e2e/leaderboard-auth-gating.spec.ts tests-e2e/admin-flags-toggle.spec.ts --project=chromium",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "check:deps": "knip --include dependencies,unlisted,binaries",
    "check:deps:strict": "knip --strict",
    "check:env": "node scripts/validate-env.mjs",
    "ci:local": "pnpm guard:lockfile && pnpm lint && pnpm type-check && pnpm test:unit && pnpm test:integration && pnpm build && pnpm test:e2e:smoke",
    "docker:up": "docker compose -f docker-compose.local.yml up -d",
    "docker:down": "docker compose -f docker-compose.local.yml down",
    "docker:stop": "docker compose -f docker-compose.local.yml stop",
    "docker:logs": "docker compose -f docker-compose.local.yml logs -f",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "dev:local": "pnpm docker:up && pnpm supabase:start && pnpm dev",
    "audit:outdated": "node scripts/run-outdated-audit.mjs",
    "audit:deps:graph": "node scripts/export-dependency-graph.mjs",
    "audit:module-replacements": "node scripts/module-replacements-audit.mjs",
    "audit:e18e": "node scripts/run-e18e-audit.mjs",
    "audit:all": "pnpm audit:outdated && pnpm audit:deps:graph && pnpm audit:module-replacements && pnpm audit:e18e && pnpm check:deps",
    "check:supabase-security": "node scripts/check-supabase-security.mjs",
    "run-all-checks": "pnpm lint && pnpm type-check && pnpm test:unit && pnpm test:integration && pnpm check:supabase-security && pnpm build",
    "guard:lockfile": "pnpm install --frozen-lockfile --ignore-scripts",
    "guard:precommit": "pnpm guard:lockfile && pnpm build",
    "lockfile:sync": "pnpm install",
    "smoke": "node scripts/smoke-test.mjs",
    "clean": "rimraf .next out coverage test-results playwright-report"
  },
  "dependencies": {
    "@gamehub/game-platform": "workspace:*",
    "@gamehub/ui": "workspace:*",
    "@games/block-blast": "workspace:*",
    "@games/breakout": "workspace:*",
    "@games/checkers": "workspace:*",
    "@games/chess": "workspace:*",
    "@games/chrono-shift": "workspace:*",
    "@games/elemental-conflux": "workspace:*",
    "@games/memory": "workspace:*",
    "@games/platformer": "workspace:*",
    "@games/quantum-architect": "workspace:*",
    "@games/rite-of-discovery": "workspace:*",
    "@games/snake": "workspace:*",
    "@games/spell-craft": "workspace:*",
    "@games/systems-discovery": "workspace:*",
    "@games/tetris": "workspace:*",
    "@games/tower-defense": "workspace:*",
    "@hookform/resolvers": "^3.10.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.112.3",
    "@tanstack/react-query": "^5.101.4",
    "@tiptap/extension-link": "^3.30.2",
    "@tiptap/extension-placeholder": "^3.30.2",
    "@tiptap/react": "^3.30.2",
    "@tiptap/starter-kit": "^3.30.2",
    "@upstash/redis": "^1.38.2",
    "@vercel/analytics": "^2.0.1",
    "lucide-react": "^0.562.0",
    "next": "^16.2.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.83.0",
    "server-only": "^0.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.184.1",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "knip": "^5.88.1",
    "postcss": "^8.5.26",
    "postcss-load-config": "^6.0.1",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
